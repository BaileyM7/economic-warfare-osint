# ============================================================
# Economic Warfare OSINT System — API Keys & Configuration
# ============================================================
# Copy this file to .env and fill in your keys.
# Only ANTHROPIC_API_KEY is strictly required for the demo.
# All other keys are free-tier — see registration links below.
# ============================================================

# --- REQUIRED ---------------------------------------------------
# Claude API key (https://console.anthropic.com/)
# This is the ONLY paid service. Pay-per-use, ~$5-20 for demo.
ANTHROPIC_API_KEY=

# --- APP ENVIRONMENT & SECURITY --------------------------------
# Environment: development | staging | production. Drives prod-only config
# validation at boot (src/common/config.py). Local + staging = development;
# the Render service should set APP_ENV=production.
APP_ENV=development

# HMAC secret that signs auth tokens. MUST be a strong random value in
# production — a default here means forgeable login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EMISSARY_AUTH_SECRET=dev-secret-change-me

# Comma-separated usernames granted admin (the /api/admin/* routes). Empty = none.
EMISSARY_ADMIN_USERS=

# Demo login (used when no admin account matches). Change for any shared deploy.
EMISSARY_DEMO_USERNAME=analyst
EMISSARY_DEMO_PASSWORD=demo

# Comma-separated CORS origins the API accepts. Set to the real frontend URL in prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Load demo COA/briefing/activity data on a FRESH database. Seeding is
# seed-only-if-empty and never overwrites existing rows. Use "1" locally for a
# populated demo; keep "0" in production so real analyst data is never reseeded.
EMISSARY_MOCK_DATA=0

# Risk-feed source mode: auto | live | fixture (see src/routers/risk_feed.py).
RISK_FEED_MODE=auto

# --- FREE WITH REGISTRATION ------------------------------------

# FRED API key (https://fred.stlouisfed.org/docs/api/api_key.html)
# Used for: macro indicators, VIX, interest rates, commodity proxies
FRED_API_KEY=

# UN Comtrade API key (https://comtradeplus.un.org/TradeFlow)
# Used for: bilateral trade flows, commodity dependencies
COMTRADE_API_KEY=

# ACLED API (https://developer.acleddata.com/)
# Used for: conflict/protest event data
# Register at acleddata.com — free for researchers
ACLED_API_KEY=
ACLED_EMAIL=

# OpenCorporates API (https://api.opencorporates.com/)
# Used for: company search, officer lookup, corporate trees
# Free tier available — optional, works without key (rate limited)
OPENCORPORATES_API_KEY=

# AISStream.io — free WebSocket of the global AIS firehose
# Register at https://aisstream.io/ — no credit card, no quota disclosed
# Used by the weekly Taiwan-strait + Spratlys zone-presence ingest;
# the /api/vessel-track endpoint resolves particulars via OpenSanctions
# (vessel schema) and the curated data/fixtures/vessels.json set.
AISSTREAM_API_KEY=

# Optional: AIS sample window in seconds (default 300 = 5 min per ingest run)
# AISSTREAM_SAMPLE_SECONDS=300

# --- NO KEY NEEDED (just works) ---------------------------------
# These sources require no API key:
# - OFAC SDN (U.S. Treasury sanctions list)
# - OpenSanctions.org (unified sanctions database)
# - GLEIF (Legal Entity Identifier registry)
# - ICIJ Offshore Leaks (Panama/Pandora Papers)
# - GDELT 2.0 (global news events)
# - IMF Data APIs
# - World Bank APIs
# - yfinance (Yahoo Finance)
# - SEC EDGAR (requires User-Agent, hardcoded in client)
# - EIA Open Data
# - MarineCadastre AIS

# --- OPTIONAL CONFIG --------------------------------------------
# Claude model to use (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Cache TTL in seconds (default: 3600 = 1 hour)
# CACHE_TTL_SECONDS=3600

# Cache directory (default: data/cache/)
# CACHE_DIR=data/cache

# --- WARGAME TAB (swarm microservice) ---------------------------
# The /wargame tab talks directly to a separately-deployed swarm
# backend (C:\Work\swarm). Set these at the frontend build step
# (e.g. Render dashboard → Environment → Add env var).
# Dev defaults: http://localhost:8000 / ws://localhost:8000.
#
# VITE_SWARM_API_URL=https://swarm-api.example.com
# VITE_SWARM_WS_URL=wss://swarm-api.example.com
#
# Swarm's CORS_ORIGINS must include the Emissary frontend URL.

# --- NOTIFICATIONS (Twilio SMS + SendGrid email) ----------------
# Kill-switch: notifications are OFF by default. Set to "true" to enable
# the SMS/email notifications pipeline (rest of these vars must also be
# configured for the enabled providers to actually send).
NOTIFICATIONS_ENABLED=false

# Twilio SMS (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# SendGrid email (https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=
NEWSLETTER_FROM_EMAIL=noreply@emissary.demo
NEWSLETTER_FROM_NAME=Emissary Weekly Brief

# Per-user daily SMS cap (anti-abuse / cost ceiling)
SMS_DAILY_CAP_PER_USER=3

# Shared-secret token required by the notifications cron endpoint
NOTIFICATIONS_CRON_TOKEN=

# Comma-separated allowlist of phone numbers / emails permitted to receive
# notifications during the demo (empty = no allowlist enforced).
NOTIFICATIONS_ALLOWLIST=

# Local development only — stub the Twilio client (no real API calls, no
# credit used, all "sends" logged to data/twilio_stub.jsonl). Requires
# NOTIFICATIONS_ENABLED=true to take effect. NEVER set in production.
TWILIO_STUB_MODE=false

# Local development only — stub SendGrid (no real API calls, no free-tier
# quota used, all "sends" logged to data/sendgrid_stub.jsonl). Requires
# NOTIFICATIONS_ENABLED=true. NEVER set in production.
SENDGRID_STUB_MODE=false

# Base URL used to construct preferences + unsubscribe links in outgoing
# email. Must be publicly reachable in production (CAN-SPAM compliance).
APP_BASE_URL=https://emissary.onrender.com

# --- OPTIONAL DATA-SOURCE KEYS (improve coverage / limits) ------
# All optional — the app degrades gracefully without them.
# OpenSanctions (https://www.opensanctions.org/api/) — higher rate limits.
OPENSANCTIONS_API_KEY=
# Trade.gov Consolidated Screening List (https://developer.trade.gov/). FREE.
# CSL powers BIS Entity List + OFAC + EU/UK/UN aggregation (sector-analysis,
# person-profile, entity-risk-report all rely on it). Strongly recommended.
TRADE_GOV_API_KEY=
# Finnhub (https://finnhub.io/) — equity fallback when Yahoo blocks cloud IPs.
FINNHUB_API_KEY=
# Sayari Graph — premium entity resolution / UBO chains.
SAYARI_CLIENT_ID=
SAYARI_CLIENT_SECRET=

# --- WARGAME BACKEND (embedded swarm sim; optional) ------------
# Mounted at /api/wargame when enabled. Needs Postgres + Redis — leave disabled
# locally unless you have both running (install deps: uv sync --extra wargame).
WARGAME_ENABLED=0
# Async Postgres DSN (pgvector). Render injects this in prod.
# DATABASE_URL=postgresql+asyncpg://swarm:swarm@localhost:5432/swarm
# Redis for rate-limit counters + sim pub/sub. Leave UNSET locally: a stale or
# unreachable REDIS_URL now safely falls back to in-memory limiting (no 500s).
# REDIS_URL=redis://localhost:6379/0
# AGENT_MODEL=claude-sonnet-4-6
# ARBITER_MODEL=claude-opus-4-6
# AGENT_RUNNER_IMPL=langgraph        # "null" (stub) or "langgraph" (real Claude)
# VOYAGE_API_KEY=                    # embeddings for agent memory (optional)
